# Copy to .env for a deployment-specific configuration.
APP_ENV=development
HOST=127.0.0.1
PORT=5179
ALLOWED_HOSTS=127.0.0.1,localhost
# In production, set both values; the password must be at least 16 characters.
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=
MAX_BODY_MB=25
# SQLite file location. Relative paths are resolved from the app folder.
ACCOUNTING_DB_PATH=data/accounting.sqlite3
